# Copia este archivo a .env (local) o define estas variables en Render > Environment.
# NUNCA subas el .env real a GitHub.

# --- Obligatorias ---
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Mínimo 32 caracteres. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Mínimo 12 caracteres
ADMIN_PASSWORD=
# URL pública de la app, con https en producción (ej. https://tu-app.onrender.com)
APP_URL=
# Opcional: texto final del extracto bancario (el prefijo se pone en Stripe > Settings > Public details)
STATEMENT_DESCRIPTOR_SUFFIX=

# --- Correo (configura UNO; prioridad: Gmail API > SendGrid > Brevo > SMTP) ---
FROM_EMAIL=
FROM_NAME=Secure Payment
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDGRID_API_KEY=
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS (opcional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
